# D:\dev\loyo-os\.env.example

# API endpoint (pro CLI)
LOYO_API_URL=http://localhost:3001

# Ollama (už máš v API)
OLLAMA_HOST=http://localhost:11434

# Lopatinka - agent na výhodnou elektroniku (Sbazar + Aukro -> Telegram)
# Bot vytvoříš u @BotFather, chat id zjistíš přes /getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Volitelné - pro lepší enrichment (pokud přidáš později)
# SERPAPI_KEY=your_serpapi_key_here
# GOOGLE_PLACES_KEY=your_google_places_key_here
# Mary Jane - řídicí bot (celý systém z Telegramu, jeden token pro všechno)
# Lopatinka vlastního bota nemá - tipy posílá přes stejný TELEGRAM_BOT_TOKEN a 👍/👎 obsluhuje Mary.
# Volitelný override, kdybys chtěl Mary na samostatném botovi:
TELEGRAM_MARY_BOT_TOKEN=
# Nepovinné - tvůj chat id; když chybí, použije se TELEGRAM_CHAT_ID
TELEGRAM_MARY_CHAT_ID=

# Luuu - mailař (čte poštu přes IMAP, jen pro čtení; souhrn v /daily-brief)
# Heslo = "heslo pro aplikace" (Gmail/Seznam/Outlook), ne hlavní heslo účtu
LUUU_IMAP_USER=
LUUU_IMAP_PASS=
LUUU_PROVIDER=gmail
# Volitelně: odesílatelé, kteří jsou vždy důležití (adresa nebo @domena)
LUUU_IMPORTANT=
# Volitelně: maily od těchto odesílatelů Luuu přesune do Koše (adresa nebo @domena, oddělit čárkou)
LUUU_DELETE=
