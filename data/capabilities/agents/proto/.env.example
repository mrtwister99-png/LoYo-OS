# Agent Proto - vzor konfigurace. Zkopiruj na .env a dopln hodnoty.
# .env se NIKDY necommituje.

# Port HTTP serveru
PORT=4319

# Ktery pronajimatel je vychozi (nazev souboru v tenants/ bez .json)
PROTO_TENANT=demo

# LLM (OpenAI-kompatibilni API). Bez klice agent jede v deterministickem rezimu.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://freebuff.com/api/v1/paid
OPENAI_MODEL=gpt-4o-mini

# Napojeni na Shoptet (jen kdyz tenant pouziva "provider": "shoptet")
SHOPTET_API_URL=https://api.myshoptet.com/api
SHOPTET_API_TOKEN=

# Kam ukladat tikety, vratky a logy (default: data/capabilities/agents/proto/data)
# PROTO_DATA_DIR=
