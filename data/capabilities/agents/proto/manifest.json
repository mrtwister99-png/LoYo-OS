{
  "id": "proto",
  "type": "agent",
  "displayName": "Proto - AI podpora e-shopu",
  "version": "0.1.0",
  "status": "active",
  "description": "Pronajímatelný AI support agent pro české e-shopy. Vloží se do webu jedním script tagem a řeší stav objednávky, tracking, vratky, reklamace, sklad a faktury přes šest nástrojů. Bez OPENAI_API_KEY jede deterministický český fallback, takže funguje i bez modelu.",
  "runtime": "node",
  "entrypoint": "./server.js",
  "start": "node server.js",
  "promptFile": "prompts/system.md",
  "packageDir": "data/capabilities/agents/proto",
  "port": 4319,
  "number": 19,
  "category": "rental",
  "model": "gpt-4o-mini",
  "healthcheck": "http://localhost:4319/api/health",
  "endpoints": {
    "demo": "http://localhost:4319/demo",
    "widget": "http://localhost:4319/widget.js",
    "chat": "http://localhost:4319/api/chat",
    "config": "http://localhost:4319/api/config"
  },
  "env": [
    "PORT",
    "PROTO_TENANT",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "OPENAI_MODEL",
    "SHOPTET_API_URL",
    "SHOPTET_API_TOKEN",
    "PROTO_DATA_DIR"
  ],
  "permissions": [
    "fs:read:data/capabilities/agents/proto/*",
    "fs:write:data/capabilities/agents/proto/data/*",
    "exec:data/capabilities/agents/proto/server.js",
    "net:fetch:http://localhost:4319/*",
    "net:fetch:https://freebuff.com/*",
    "net:fetch:https://api.openai.com/*",
    "net:fetch:https://api.myshoptet.com/*"
