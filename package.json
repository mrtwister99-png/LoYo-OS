{
  "name": "loyo-os",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "manifest:check": "tsx tools/scripts/manifest-check.ts",
    "agent:new": "tsx tools/scripts/agent-new.ts",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "db:push": "turbo run db:push",
    "cli:firmy": "tsx tools/cli/firmy/index.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "turbo": "^2.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm manifest:check"
    ]
  }
}
