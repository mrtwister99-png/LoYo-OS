{
  "name": "loyo-os",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "manifest:check": "tsx tools/scripts/manifest-check.ts",
    "agent:new": "tsx tools/scripts/agent-new.ts",
    "smoke": "tsx tools/scripts/smoke.ts",
    "rag:init": "tsx tools/scripts/rag.ts init",
    "rag:index": "tsx tools/scripts/rag.ts index",
    "rag:search": "tsx tools/scripts/rag.ts search",
    "rag:status": "tsx tools/scripts/rag.ts status",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter api dev",
    "dev:api:clean": "tsx tools/scripts/dev-api-clean.ts",
    "build": "turbo run build",
    "db:push": "turbo run db:push",
    "cli:firmy": "tsx tools/cli/firmy/index.ts",
    "cli:tridil": "tsx tools/cli/tridil/index.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "tsx": "^4.19.1",
    "turbo": "^2.3.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm manifest:check"
    ]
  },
  "dependencies": {
    "playwright-core": "^1.65.1"
  }
}
